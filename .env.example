# Connecteur Invoice Ninja × SUPER PDP — modèle de configuration.
# Copier vers le fichier .env de déploiement (hors Git, droits 600) et compléter.
# Ce fichier ne doit JAMAIS contenir de vraie valeur secrète.

APP_NAME="Facturation electronique"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://einvoicing.example.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/einvoicing.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Alertes e-mail : SMTP standard. « log » n'envoie rien (journal applicatif seulement).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=einvoicing@example.com
MAIL_FROM_NAME="Invoice Bridge"

# --- Interrupteurs (tout est coupé par défaut) ------------------------------
# false : aucune écriture vers SUPER PDP, la tâche planifiée ne fait rien.
EINVOICING_ENABLED=false
# false : aucune émission (factures de vente, avoirs, statut « Encaissée ») ;
# la réception fonctionne seule si EINVOICING_ENABLED=true.
EINVOICING_SEND_ENABLED=false
# false : seules les factures marquées « À transmettre » dans Invoice Ninja partent.
EINVOICING_AUTO_SEND=false
# false : les factures reçues sont archivées mais importées manuellement.
EINVOICING_AUTO_RECEIVE=false
# Statut « Encaissée » (fr:212) automatique quand la facture est soldée.
EINVOICING_REPORT_PAYMENTS=false
EINVOICING_AUTO_CREATE_VENDORS=true
# Les factures antérieures ne sont jamais transmises automatiquement.
EINVOICING_SEND_FROM_DATE=2026-09-01
EINVOICING_SYNC_EVERY_MINUTES=10
EINVOICING_RUN_MIGRATIONS=true

# --- Invoice Ninja ------------------------------------------------------------
INVOICE_NINJA_URL=https://facturation.example.fr
# Jeton d'un utilisateur dédié NON administrateur (voir docs/installation.md).
INVOICE_NINJA_API_TOKEN=
# Délai max. (s) pour le téléchargement d'un PDF (rendu Chromium côté Invoice Ninja).
INVOICE_NINJA_PDF_TIMEOUT=180
EINVOICING_WRITE_BACK=true
EINVOICING_UPLOAD_DOCUMENTS=true
# Notes « E-facture : … » dans l'historique des factures, avoirs et dépenses.
EINVOICING_ACTIVITY_NOTES=true
EINVOICING_FIELD_ACTION=custom_value1
EINVOICING_FIELD_STATUS=custom_value2
EINVOICING_FIELD_REFERENCE=custom_value3
EINVOICING_FIELD_DETAIL=custom_value4
# Valeurs de la liste « Facture électronique » (identiques aux options du champ personnalisé).
EINVOICING_ACTION_SEND="Transmettre à SuperPDP"
EINVOICING_ACTION_SEND_DEPOSIT="Transmettre à SuperPDP (acompte)"
EINVOICING_ACTION_SKIP="Ne pas transmettre"
# Nouvelle préparation d'une facture bloquée ou en erreur, puis retour à « Transmettre à SuperPDP ».
EINVOICING_ACTION_RETRY="Relancer la transmission"
EINVOICING_EXPENSE_FIELD_REFERENCE=custom_value1
EINVOICING_EXPENSE_FIELD_STATUS=custom_value2
EINVOICING_EXPENSE_CATEGORY=

# --- SUPER PDP ----------------------------------------------------------------
# Même URL pour les deux environnements : ce sont les identifiants qui déterminent
# sandbox ou production. Le connecteur refuse d'écrire si SUPERPDP_ENVIRONMENT ne
# correspond pas à l'environnement réel des identifiants.
SUPERPDP_API_URL=https://api.superpdp.tech
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
SUPERPDP_ENVIRONMENT=sandbox
# Sandbox uniquement : adresse de l'entreprise fictive destinataire (ex. 315143296_XXX).
SUPERPDP_SANDBOX_BUYER_ADDRESS=
# Bac à sable uniquement : application de la seconde entreprise de test (Tricatel),
# utilisée par einvoicing:sandbox-peer et einvoicing:recette. Jamais en production.
SUPERPDP_PEER_CLIENT_ID=
SUPERPDP_PEER_CLIENT_SECRET=
# true uniquement sur l'instance Invoice Ninja de TEST (autorise einvoicing:recette).
EINVOICING_TEST_INSTANCE=false
SUPERPDP_PRICE_PER_INVOICE=0.01
SUPERPDP_ANNUAL_MINIMUM=10

# --- Vendeur (vide = valeur lue dans Invoice Ninja / SUPER PDP) -----------------
EINVOICING_SELLER_NAME=
EINVOICING_SELLER_TRADING_NAME=
EINVOICING_SELLER_SIREN=
EINVOICING_SELLER_SIRET=
EINVOICING_SELLER_VAT_NUMBER=
EINVOICING_SELLER_ELECTRONIC_ADDRESS=
EINVOICING_SELLER_ADDRESS_LINE1=
EINVOICING_SELLER_ADDRESS_LINE2=
EINVOICING_SELLER_POST_CODE=
EINVOICING_SELLER_CITY=
EINVOICING_SELLER_COUNTRY=FR
EINVOICING_SELLER_EMAIL=
EINVOICING_SELLER_PHONE=
EINVOICING_SELLER_IBAN=
EINVOICING_SELLER_BIC=

# --- TVA et mentions ------------------------------------------------------------
# true = franchise en base (art. 293 B), false = TVA collectée. À fixer explicitement.
EINVOICING_VAT_FRANCHISE=false
EINVOICING_VAT_EXEMPTION_CODE=VATEX-FR-FRANCHISE
EINVOICING_VAT_EXEMPTION_TEXT="TVA non applicable, art. 293 B du CGI"
EINVOICING_NOTE_PMT="Indemnité forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 €."
EINVOICING_NOTE_PMD="Pénalités de retard : trois fois le taux d'intérêt légal."
EINVOICING_NOTE_AAB="Pas d'escompte pour paiement anticipé."
EINVOICING_BUSINESS_PROCESS=S
EINVOICING_PAYMENT_TERMS="Paiement à réception de facture."

# --- Tableau de bord et webhook -------------------------------------------------
EINVOICING_DASHBOARD_USER=admin
# php -r 'echo password_hash("mot-de-passe", PASSWORD_BCRYPT), PHP_EOL;'
# (dans un fichier .env, doubler les $ ou mettre la valeur entre apostrophes)
EINVOICING_DASHBOARD_PASSWORD_HASH=
# Secret partagé, en-tête X-Einvoicing-Secret (openssl rand -hex 32)
EINVOICING_WEBHOOK_SECRET=
EINVOICING_LOG_RETENTION_DAYS=400

# --- Alertes (journal du tableau de bord + e-mail / webhook) -------------------
# Destinataire(s), séparés par des virgules. Sans valeur : journal seulement.
EINVOICING_NOTIFY_MAIL_TO=
# Optionnel. Inutile si MAIL_MAILER=smtp. Jeton d'une API HTTP type Mailtrap.
EINVOICING_NOTIFY_MAILTRAP_TOKEN=
EINVOICING_NOTIFY_MAILTRAP_HOST=send.api.mailtrap.io
EINVOICING_NOTIFY_MAILTRAP_FROM=
# Optionnel : ntfy / Gotify / Slack-compatible (corps texte, titre dans « Title »).
EINVOICING_NOTIFY_WEBHOOK_URL=
EINVOICING_NOTIFY_EVENTS=received,rejected,sync_failed,credentials,outage
EINVOICING_NOTIFY_FAILURES_AFTER=2
EINVOICING_NOTIFY_OUTAGE_MINUTES=60
EINVOICING_DASHBOARD_URL="${APP_URL}"
